# VoiceAgents environment contract.
#
# This file mirrors the normative table in specs/02-repo-layout-and-conventions.md §6 one-to-one, in table
# order, with values that work against the local stack from `make up`. It is committed; `.env` is gitignored.
#
#   cp .env.example .env
#
# Keep the two in lockstep: scripts/tests/test_env_example.py fails when a variable exists in §6 but not here,
# or here but not in §6. Add new variables to the spec table and to this file in the same commit.
#
# Values left empty are optional in local development. The secrets below are fixed, obviously synthetic dev
# fillers — regenerate each with `openssl rand -hex 32` before using this configuration anywhere else.
#
# Values the local stack produces for you rather than values you type:
#   - `make up` writes the simulator's Telnyx Ed25519 public key to `.sim/telnyx_public_key`; copy it into
#     TELNYX_PUBLIC_KEY, or let the `local` environment read the file directly.
#   - `scripts/telnyx_bootstrap.py` creates the Telnyx Call Control application and profile ids.
#   - `scripts/seed_dev.py` creates the shared caller-ID pool org for PLATFORM_POOL_ORG_ID.

# --- Core ---
VA_ENV=local  # `local`/`test`/`staging`/`production`
LOG_LEVEL=INFO  # root log level for every service
LOG_TRANSCRIPTS=true  # allow transcript text in logs (forced false in production)

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://va:va@localhost:5432/va  # Postgres DSN, asyncpg driver
DATABASE_POOL_SIZE=10  # SQLAlchemy async pool size per process
REDIS_URL=redis://localhost:6379/0  # Redis connection URL
CLICKHOUSE_URL=http://default:@localhost:8123/va  # ClickHouse HTTP URL for the events sink and analytics

# --- Temporal ---
TEMPORAL_HOST=localhost:7233  # Temporal frontend host:port
TEMPORAL_NAMESPACE=default  # Temporal namespace
TEMPORAL_TASK_QUEUE=va-main  # base queue; `va-postcall`, `va-ingest` derived with suffixes

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT_URL=http://localhost:9000  # empty in AWS
S3_REGION=us-east-1  # object storage region
S3_BUCKET_RECORDINGS=va-recordings  # bucket holding call recordings
S3_BUCKET_KB=va-kb  # bucket holding knowledge-base documents
S3_BUCKET_VOICES=va-voice-samples  # bucket holding voice-cloning samples
S3_ACCESS_KEY_ID=minio  # empty in AWS (IRSA)
S3_SECRET_ACCESS_KEY=minio12345  # empty in AWS (IRSA)

# --- Public hosts ---
PUBLIC_API_BASE_URL=http://localhost:8000  # base URL clients, docs, and SDK tests target
EDGE_PUBLIC_HOST=localhost:8100  # host Telnyx posts webhooks to (tunnel host for live tests)
MEDIA_PUBLIC_HOST=localhost:8200  # host Telnyx opens media WS to (tunnel host for live tests)
DASHBOARD_BASE_URL=http://localhost:3000  # CORS + email links

# --- Secrets and envelope encryption ---
SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef  # session signing; regenerate with `openssl rand -hex 32`
STREAM_TOKEN_SECRET=cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe  # HMAC for media WS tokens; regenerate with `openssl rand -hex 32`
KMS_PROVIDER=local  # `local` (AES-256-GCM master key from env) or `aws`
LOCAL_MASTER_KEY=feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface  # 32-byte master key for envelope encryption in local/test; regenerate with `openssl rand -hex 32`
AWS_KMS_KEY_ID=  # KMS key ARN in AWS

# --- Telephony (Telnyx) ---
TELNYX_API_BASE=http://localhost:9100/v2  # sim; real: `https://api.telnyx.com/v2`
TELNYX_API_KEY=sim-telnyx-key  # platform master Telnyx key
TELNYX_PUBLIC_KEY=  # Ed25519 public key (base64) for webhook verification; sim key written to `.sim/telnyx_public_key` by `make up`
TELNYX_CALL_CONTROL_APP_ID=  # platform Call Control Application id (connection_id); created by `scripts/telnyx_bootstrap.py`
TELNYX_MESSAGING_PROFILE_ID=  # platform messaging profile; created by bootstrap
TELNYX_OUTBOUND_VOICE_PROFILE_ID=  # platform outbound voice profile; created by bootstrap

# --- Speech (ElevenLabs) ---
ELEVENLABS_API_BASE=http://localhost:9200  # sim; real: `https://api.elevenlabs.io`
ELEVENLABS_WS_BASE=ws://localhost:9200  # real: `wss://api.elevenlabs.io` (US: `wss://api.us.elevenlabs.io`)
ELEVENLABS_API_KEY=sim-eleven-key  # platform ElevenLabs key
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5  # streaming TTS model
ELEVENLABS_STT_MODEL=scribe_v2_realtime  # realtime STT model
ELEVENLABS_BATCH_STT_MODEL=scribe_v2  # batch STT model for post-call transcription

# --- LLM and embeddings (Telnyx Inference) ---
LLM_DEFAULT_BASE_URL=http://localhost:9300/v1  # sim; real: `https://api.telnyx.com/v2/ai/openai`
LLM_DEFAULT_API_KEY=sim-llm-key  # real: Telnyx API key
LLM_DIALOGUE_MODEL=zai-org/GLM-5.3-Flash  # model driving live conversation turns
LLM_ROUTER_MODEL=zai-org/GLM-5.3-Flash  # classification/routing/extraction
LLM_ANALYSIS_MODEL=zai-org/GLM-5.3  # post-call analysis (quality over speed)
LLM_FALLBACK_MODEL=moonshotai/Kimi-K2.6  # used when the primary model errors or times out
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-8B  # embedding model for knowledge-base vectors
EMBEDDINGS_DIMENSIONS=1024  # must match `vector(1024)` columns

# --- Billing (Stripe) ---
STRIPE_API_BASE=http://localhost:9400  # sim; real: `https://api.stripe.com`
STRIPE_SECRET_KEY=sk_test_sim  # Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_sim  # secret used to verify Stripe webhook signatures

# --- Email ---
SMTP_URL=smtp://localhost:1025  # transactional email (mailpit in compose)
EMAIL_FROM="VoiceAgents <no-reply@voiceagents.local>"  # From header on transactional email

# --- Authentication ---
OIDC_ENABLED=false  # enterprise SSO

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OTLP endpoint for traces and metrics (otel-collector in compose)
SENTRY_DSN=  # backend Sentry DSN; empty disables reporting

# --- Media worker and code sandbox ---
DENO_PATH=/usr/local/bin/deno  # Deno binary used by the custom-code sandbox
MEDIA_DRAIN_TIMEOUT_S=2700  # drain window for in-flight calls on media-worker shutdown
MEDIA_MAX_CALLS_PER_POD=60  # admission control
POD_ID=  # media-worker pod identity; empty falls back to the hostname
WIDGET_PUBLIC_HOST=localhost:8200  # widget audio WS host
LIVE_TESTS=0  # `1` enables live vendor smoke tests
CUSTOM_CODE_MAX_CONCURRENCY=8  # Deno sandbox concurrent executions per process

# --- Platform defaults ---
PLATFORM_DEFAULT_VOICE=Karen  # display name of the platform default voice (`15-voices.md` maps it to a curated ElevenLabs premade voice)
PLATFORM_POOL_ORG_ID=  # system org owning the shared caller-ID pool (`16-phone-numbers.md`); created by `scripts/seed_dev.py` / bootstrap
SUPPORTED_NUMBER_COUNTRIES=US,CA,GB,AU,IE,DE,FR,ES,NL,SE,MX,BR  # countries where numbers can be searched/purchased
INTERNATIONAL_ALLOWED_COUNTRIES=US,CA,GB,AU,IE,NZ,DE,FR,ES,IT,NL,BE,SE,NO,DK,FI,MX,BR,IN,PH,SG  # destinations ever dialable; others always blocked

# --- Outbound webhooks and tool targets ---
WEBHOOK_ALLOW_PRIVATE=true  # allow private-IP webhook/tool targets in local/test (forced `false` in staging/production)

# --- Compliance posture ---
ELEVENLABS_ZERO_RETENTION_AVAILABLE=false  # platform ElevenLabs account supports `enable_logging=false` (required for HIPAA mode)
LLM_DEFAULT_BAA_COVERED=false  # default Telnyx Inference provider is covered by a BAA

# --- Cost of goods ---
LLM_MODEL_COSTS_JSON={}  # per-model COGS overrides `{"model":{"in_per_1k_micros":n,"out_per_1k_micros":n}}` merged over built-in defaults
COGS_TELNYX_OUTBOUND_PER_MIN_MICROS=7000  # COGS estimate overrides; full list of `COGS_*` variables and defaults in `24-billing-and-limits.md`

# --- Vendor protocol and cost tuning ---
TELNYX_L16_BYTE_ORDER=big  # byte order of L16 payloads on the Telnyx media WS (`hd_audio`), verified by live smoke test
ELEVENLABS_STT_SESSION_ROTATE_S=1500  # proactively rotate the Scribe session before vendor session limits
ELEVENLABS_STT_KEYTERMS_ENCODING=repeated  # `repeated` (`keyterms=a&keyterms=b`) or `json` query encoding
ELEVENLABS_STT_COST_MICROS_PER_SECOND=75  # STT COGS estimate
ELEVENLABS_TTS_COST_MICROS_PER_1K_CHARS=50000  # TTS COGS estimate

# --- Simulators (apps/sim, ports 9100-9400) ---
SIM_STT_COMMIT_LATENCY_MS=60  # simulator real-time mode STT commit latency
SIM_TTS_TTFA_MS=80  # simulator TTS time to first audio
SIM_LLM_TTFT_MS=150  # simulator LLM time to first token
SIM_LLM_TOKENS_PER_S=80  # simulator LLM token rate
SIM_LLM_RULES=  # comma-separated FakeLLM rule files (`30-testing-and-evals.md`)
SIM_ED25519_PRIVATE_KEY=  # base64 Ed25519 private key for simulated Telnyx signatures; generated at startup
SIM_EDGE_WEBHOOK_URL=http://localhost:8100/telnyx/voice  # simulated Telnyx voice webhook target
SIM_MESSAGING_WEBHOOK_URL=http://localhost:8100/telnyx/messaging  # simulated Telnyx messaging webhook target
SIM_STRIPE_WEBHOOK_URL=http://localhost:8000/v1/billing/stripe/webhook  # simulated Stripe webhook target
SIM_STATE_REDIS_URL=  # shared simulator state for multi-process sims
SIM_WORKERS=1  # simulator worker processes (load tests use 8)

# --- Live vendor smoke tests (only read when LIVE_TESTS=1) ---
LIVE_TELNYX_API_KEY=  # live smoke: Telnyx key of the test account (`30-testing-and-evals.md` live smoke tests)
LIVE_TELNYX_CONNECTION_ID=  # live smoke: Call Control app used by the caller harness
LIVE_FROM_NUMBER=  # live smoke: E.164 number the platform dials from
LIVE_TEST_ANSWER_NUMBER=  # live smoke: E.164 number answered by the caller harness
LIVE_ELEVENLABS_API_KEY=  # live smoke: ElevenLabs key
LIVE_LLM_API_KEY=  # live smoke: Telnyx Inference key

# --- Key rotation and sessions ---
API_KEY_PEPPER=0badc0de0badc0de0badc0de0badc0de0badc0de0badc0de0badc0de0badc0de  # 32-byte pepper mixed into API key hashes (`04-auth-tenancy-rbac.md`); regenerate with `openssl rand -hex 32`
API_KEY_PEPPER_PREVIOUS=  # previous pepper used to verify keys whose `pepper_version` is older
SECRET_KEY_PREVIOUS=  # previous session signing key accepted during rotation
STREAM_TOKEN_SECRET_PREVIOUS=  # previous media WS token secret accepted during rotation
SESSION_COOKIE_DOMAIN=  # dashboard session cookie domain (empty keeps a host-only cookie)

# --- Generated OpenAPI document ---
OPENAPI_PUBLIC_SERVER_URL=http://localhost:8000  # `servers[0].url` in the generated OpenAPI document

# --- Logging and tracing ---
LOG_FORMAT=console  # structlog renderer; `console` in local, `json` elsewhere
# LOG_LEVEL_VA_MEDIA=DEBUG  # per-logger level override `LOG_LEVEL_<COMPONENT>`, unset by default (`27-observability.md`)
OTEL_TRACES_SAMPLER_ARG=0.1  # HTTP trace sampling ratio; calls are always sampled

# --- Dashboard (browser) ---
NEXT_PUBLIC_SENTRY_DSN=  # browser Sentry DSN

# --- Clocks ---
VA_CLOCK=system  # `system` or `fake-shared` (accelerated e2e only; reads virtual time from the simulator)
SIM_CLOCK=realtime  # `realtime` or `accelerated`

# --- CI ---
SLACK_ALERTS_WEBHOOK=  # Slack incoming webhook for live smoke failures
