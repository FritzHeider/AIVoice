{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "description": "Error body of envelope endpoints.",
        "examples": [
          {
            "data": null,
            "errors": [
              {
                "error": "NOT_FOUND",
                "message": "Not found."
              }
            ],
            "request_id": "req_0192f3a4b5c67d8e9f0a1b2c3d4e5f60"
          }
        ],
        "properties": {
          "data": {
            "title": "Data",
            "type": "null"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "title": "Errors",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "data",
          "errors",
          "request_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorItem": {
        "description": "One ``errors[]`` entry.",
        "examples": [
          {
            "error": "INVALID_INPUT",
            "field": "phone_number",
            "message": "must be E.164"
          }
        ],
        "properties": {
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Structured error details",
            "title": "Details"
          },
          "error": {
            "description": "Error code from the error catalog",
            "title": "Error",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Dotted path of the invalid field",
            "title": "Field"
          },
          "message": {
            "description": "Human-readable message",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorItem",
        "type": "object"
      },
      "ErrorLegacy": {
        "description": "Error body of legacy (Bland-compatible) endpoints.",
        "examples": [
          {
            "errors": [
              {
                "error": "NOT_FOUND",
                "message": "Not found."
              }
            ],
            "message": "Not found.",
            "request_id": "req_0192f3a4b5c67d8e9f0a1b2c3d4e5f60",
            "status": "error"
          }
        ],
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "title": "Errors",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "error",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "message",
          "errors",
          "request_id"
        ],
        "title": "ErrorLegacy",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Public health status; never reveals dependency state.",
        "examples": [
          {
            "status": "ok"
          }
        ],
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      }
