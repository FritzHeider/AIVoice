                "schema": {
                  "$ref": "#/components/schemas/ErrorLegacy"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Service health",
        "tags": [
          "Health"
        ],
        "x-envelope": "legacy",
        "x-scope": "public"
      }
    },
    "/v1/org/sso": {
      "delete": {
        "description": "Remove the org's OIDC connection.",
        "operationId": "org_sso_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse_SsoConnectionDeleted_"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Org Sso Delete",
        "tags": [
          "Org"
        ],
        "x-envelope": "envelope",
        "x-permission": "sso.manage",
        "x-scope": "org:write"
      },
      "get": {
        "description": "The org's OIDC connection (never its client secret).",
        "operationId": "org_sso_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse_SsoConnectionView_"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Org Sso Get",
        "tags": [
          "Org"
        ],
        "x-envelope": "envelope",
        "x-permission": "sso.manage",
        "x-scope": "org:read"
      },
      "put": {
        "description": "Create or replace the org's OIDC connection after validating the issuer's discovery document.",
        "operationId": "org_sso_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SsoConnectionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse_SsoConnectionView_"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid input"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Org Sso Put",
        "tags": [
          "Org"
        ],
        "x-envelope": "envelope",
        "x-permission": "sso.manage",
        "x-scope": "org:write"
      }
    }
  },
