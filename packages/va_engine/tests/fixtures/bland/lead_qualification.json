          "body": null,
          "timeoutMs": 5000,
          "retries": 1,
          "speech": "One moment while I pull up your details.",
          "responseData": [
            {
              "name": "lead_status",
              "data": "$.lead.status",
              "context": "Lead status in the CRM"
            },
            {
              "name": "monthly_bill",
              "data": "$.lead.monthly_bill",
              "context": "Average electricity bill"
            }
          ],
          "routeOnStatus": {
            "2xx": null,
            "4xx": "qualify",
            "5xx": "qualify",
            "timeout": "qualify"
          },
          "responsePathways": [
            {
              "variable": "lead_status",
              "operator": "==",
              "value": "customer",
              "targetNodeId": "existing"
            },
            {
              "variable": "monthly_bill",
              "operator": ">=",
              "value": 150,
              "targetNodeId": "pitch"
            }
          ]
        },
        "extractVars": [
          {
            "name": "homeowner",
            "type": "boolean",
            "description": "Caller owns the home",
            "required": false
          }
        ]
      }
    },
